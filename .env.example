# ══════════════════════════════════════════════════════════
# Distributed File Storage Cluster — Environment Configuration Template
# ══════════════════════════════════════════════════════════

# ─── PostgreSQL ─────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=distfs
POSTGRES_PASSWORD=distfs_secret
POSTGRES_DB=distfs

# ─── Coordinator ────────────────────────────────────────
COORDINATOR_PORT=8080
CHUNK_SIZE=4194304

# ─── Reed-Solomon ───────────────────────────────────────
# K = data shards, M = parity shards
# Total = K + M = 4 (one per storage node)
DATA_SHARDS=3
PARITY_SHARDS=1
