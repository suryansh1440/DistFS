# Build stage
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Copy proto module dependency
COPY proto/ /proto/

# Copy coordinator module definition
COPY coordinator/go.mod coordinator/go.sum ./
RUN go mod download

# Copy coordinator source and SQL migrations
COPY coordinator/ .
COPY migrations/ /migrations/

# Build static Linux binary
RUN CGO_ENABLED=0 GOOS=linux go build -o /coordinator ./cmd/server

# Run stage
FROM alpine:3.19

RUN apk --no-cache add ca-certificates

WORKDIR /app

COPY --from=builder /coordinator .
COPY --from=builder /migrations/ ./migrations/

EXPOSE 8080

CMD ["./coordinator"]
